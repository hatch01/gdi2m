// Configured by CMake into the build tree - the paths below are absolute
// because the exported graph lives in export/, not next to this file, and a
// relative path in a .rc is resolved against the rc compiler's working
// directory rather than against the source.
//
// Do not edit the generated copy; edit this one.
#include "@GDI2M_RESOURCES_H@"

IDI_APPICON ICON "@GDI2M_ICON@"

@GDI2M_EMBED_BLOCK@

// What Explorer's Details tab shows. Absent, it reads as an unfinished build -
// and on a published binary that is the first thing anyone checks.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @GDI2M_VERSION_CSV@
 PRODUCTVERSION @GDI2M_VERSION_CSV@
 FILEOS         0x40004L          // VOS_NT_WINDOWS32
 FILETYPE       0x1L              // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"          // US English, Unicode
        BEGIN
            VALUE "FileDescription", "gdi2m - guitar DI to MIDI"
            VALUE "FileVersion",     "@GDI2M_VERSION@"
            VALUE "InternalName",    "gdi2m_ui"
            VALUE "OriginalFilename","gdi2m_ui.exe"
            VALUE "ProductName",     "gdi2m"
            VALUE "ProductVersion",  "@GDI2M_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
